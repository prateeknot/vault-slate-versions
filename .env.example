# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Card encryption key (used by server-side functions for decrypt)
# Must match the key used when encrypting card data
CARD_ENCRYPTION_KEY=your-32-byte-encryption-key